{
  "name": "ezcsv",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "assets:generate": "node scripts/generate-brand-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "check": "biome check . && corepack pnpm run typecheck && vitest run",
    "test": "vitest",
    "test:run": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1156.0",
    "@tanstack/react-virtual": "^3.14.22",
    "@vercel/analytics": "^1.6.1",
    "html2pdf.js": "^0.14.0",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.2",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1"
    },
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vitest": "^4.1.12"
  }
}
