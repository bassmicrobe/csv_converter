# Basic認証
# BASIC_AUTH_ENABLED=false または 0 で認証を無効化（USER/PASSWORD は残しておける）
BASIC_AUTH_ENABLED=true
BASIC_AUTH_USER=your_username
BASIC_AUTH_PASSWORD=your_password

# お問い合わせフォーム（Formspree のフォームID。未設定時は運営会社サイトへのリンク表示）
# https://formspree.io/ で無料登録後、フォーム作成で取得
NEXT_PUBLIC_FORMSPREE_FORM_ID=your_form_id

# Cloudflare Turnstile（ボット対策）。未設定時は Turnstile なしでフォーム送信可能
# https://dash.cloudflare.com/ → Turnstile でウィジェット作成、Site Key を取得
# Formspree ダッシュボードで Secret Key を設定するとサーバー側検証が有効になる
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key
