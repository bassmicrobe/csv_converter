# Basic認証
# BASIC_AUTH_ENABLED=false または 0 で認証を無効化（USER/PASSWORD は残しておける）
BASIC_AUTH_ENABLED=true
BASIC_AUTH_USER=your_username
BASIC_AUTH_PASSWORD=your_password

# AWS SES（お問い合わせフォーム）
# AWS コンソールで SES を設定し、送信元メールアドレスを検証済みにする
SES_FROM_EMAIL=noreply@yourdomain.com
SES_TO_EMAIL=contact@yourdomain.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Cloudflare Turnstile（ボット対策）
# 本番（NODE_ENV=production）ではサイトキー・シークレットの両方が必須です
# https://dash.cloudflare.com/ → Turnstile でウィジェット作成
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key
TURNSTILE_SECRET_KEY=your_secret_key

# お問い合わせの自動返信メール（省略時は送信する）。スパム対策で止める場合は false
CONTACT_AUTOREPLY_ENABLED=true
